    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">Cơ Chế Hoạt Động Của Routing Middleware</h2>
        <p class="text-muted">Cách một URL từ trình duyệt tìm đến đúng Action trong Controller</p>
    </div>

    <div class="routing-flow p-4 rounded shadow-sm mb-4">
        <div class="row text-center g-3 align-items-center">
            <div class="col-md-3">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <span class="badge bg-secondary mb-2">Bước 1</span>
                    <h6 class="fw-bold mb-0">HTTP Request</h6>
                    <small class="text-muted"><code>/Product/Detail/5</code></small>
                </div>
            </div>
            <div class="col-md-1 fs-3 text-primary">&#10142;</div>
            <div class="col-md-3">
                <div class="p-3 bg-primary text-white rounded shadow-sm">
                    <span class="badge bg-light text-dark mb-2">Bước 2</span>
                    <h6 class="fw-bold mb-0">Routing Middleware</h6>
                    <small class="text-white-50">Phân tích Pattern URL</small>
                </div>
            </div>
            <div class="col-md-1 fs-3 text-primary">&#10142;</div>
            <div class="col-md-4">
                <div class="p-3 bg-white rounded shadow-sm border">
                    <span class="badge bg-success mb-2">Bước 3</span>
                    <h6 class="fw-bold mb-0">Controller & Action</h6>
